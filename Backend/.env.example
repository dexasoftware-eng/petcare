NODE_ENV=development
PORT=5000

# MongoDB Connection (Local or Atlas Cluster)
MONGODB_URI=mongodb+srv://dexasoftware_db_user:PetCare12345@cluster0.lgysxhc.mongodb.net/furshield_db?retryWrites=true&w=majority&appName=Cluster

# JWT Configuration
JWT_ACCESS_SECRET=your_super_secret_access_key_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Client Configuration
CLIENT_URL=http://localhost:5173

# Cookie Configuration
COOKIE_NAME=furshield_refresh

# Password Hashing
BCRYPT_ROUNDS=12

# Token Expiration Settings
PASSWORD_RESET_EXPIRES_MINUTES=15
EMAIL_VERIFICATION_EXPIRES_HOURS=24

# Initial Administrator Seed Credentials
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@furshield.com
ADMIN_PASSWORD=Admin@FurShield2026!

# Email Configuration
EMAIL_FROM=no-reply@furshield.com
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
